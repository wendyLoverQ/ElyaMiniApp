{
  "type": "web-pet",
  "title": "自旋地球",
  "entry": "index.html",
  "width": 320,
  "height": 320,
  "preview": "preview.jpg",
  "operationGuide": [
    {
      "zh-CN": "Ctrl+左键拖动：旋转视角",
      "zh-TW": "Ctrl+左鍵拖曳：旋轉視角",
      "en": "Ctrl+left drag: rotate view",
      "es": "Ctrl+arrastrar con botón izquierdo: girar vista",
      "ja": "Ctrl+左ドラッグ：視点を回転",
      "ko": "Ctrl+왼쪽 드래그: 시점 회전",
      "ru": "Ctrl+перетаскивание левой кнопкой: вращать вид",
      "de": "Strg+Ziehen mit linker Taste: Ansicht drehen",
      "fr": "Ctrl+glisser avec clic gauche : faire pivoter la vue"
    }
  ],
  "presentation": {
    "viewport": {
      "preferredWidth": 320,
      "preferredHeight": 320,
      "minWidth": 320,
      "minHeight": 320,
      "maxWidth": 320,
      "maxHeight": 320,
      "resize": "none",
      "aspectRatio": "preserve"
    },
    "visualScale": {
      "owner": "host",
      "default": 1,
      "min": 0.6,
      "max": 8,
      "gestures": [
        "scale-wheel",
        "scale-hold"
      ]
    }
  },
  "settings": [
    {
      "key": "realtime",
      "label": "实时光照与转速",
      "type": "boolean",
      "default": false
    },
    {
      "key": "rotationSpeed",
      "label": "转速",
      "type": "range",
      "default": 0.12,
      "min": 0,
      "max": 1.2,
      "step": 0.01,
      "enableWhen": { "key": "realtime", "equals": false }
    }
  ],
  "permissions": [
    "networkAccess"
  ],
  "network": {
    "origins": [
      "https://clouds.matteason.co.uk",
      "https://gibs.earthdata.nasa.gov"
    ]
  }
}
